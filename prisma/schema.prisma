generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth (campos definidos pela biblioteca + plugin admin) ---

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Modera Bot ---

// A "conta" do cliente. Todo dado de moderação pertence a um workspace.
model Workspace {
  id          String              @id @default(cuid())
  name        String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships Membership[]
  instance    WhatsappInstance?
  groups      Group[]
  settings    ModerationSettings?
  blocked     BlockedDomain[]
  allowed     AllowedDomain[]
  invites     AllowedInvite[]
  adminLinks  AdminLink[]
  unknown     UnknownLink[]
  events      ModerationEvent[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Um número de WhatsApp por conta, numa instância própria da Evolution.
model WhatsappInstance {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  name          String    @unique
  webhookToken  String    @unique
  status        String    @default("disconnected")
  phone         String?
  profileName   String?
  connectedAt   DateTime?
  // último evento recebido da Evolution (debug: se parar, a Evolution parou de mandar)
  lastWebhookAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Group {
  id          String    @id @default(cuid())
  workspaceId String
  remoteJid   String
  name        String
  size        Int       @default(0)
  botIsAdmin  Boolean   @default(false)
  moderated   Boolean   @default(false)
  syncedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, remoteJid])
}

model ModerationSettings {
  workspaceId    String    @id
  enabled        Boolean   @default(false)
  deleteMode     Boolean   @default(false)
  notifyGroupJid String    @default("")
  announceDelete Boolean   @default(false)
  announceText   String    @default("*Mensagem apagada automaticamente* pelo Modera Bot. Se você acha que foi um engano, fale com um dos admins e leia as regras na descrição do grupo.")
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BlockedDomain {
  id          String    @id @default(cuid())
  workspaceId String
  domain      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
}

model AllowedDomain {
  id          String    @id @default(cuid())
  workspaceId String
  domain      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
}

// Convites chat.whatsapp.com liberados. Com groupJid, é o convite de um grupo moderado,
// descoberto e atualizado sozinho (o link muda quando um admin redefine o convite).
model AllowedInvite {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  groupJid    String?
  groupName   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, url])
  @@unique([workspaceId, groupJid])
}

// Link que um admin do grupo mandou: fica liberado por 72 horas.
model AdminLink {
  id          String    @id @default(cuid())
  workspaceId String
  urlKey      String
  sample      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, urlKey])
  @@index([expiresAt])
}

model UnknownLink {
  id            String    @id @default(cuid())
  workspaceId   String
  domain        String
  sample        String
  groupName     String
  author        String
  text          String
  count         Int       @default(1)
  lastMessageId String
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([workspaceId, lastSeenAt])
}

model ModerationEvent {
  id             String    @id @default(cuid())
  workspaceId    String
  groupJid       String
  waMessageId    String
  groupName      String
  author         String
  authorName     String    @default("")
  authorPhone    String    @default("")
  participant    String    @default("")
  participantAlt String    @default("")
  text           String
  matchedUrl     String
  action         String
  detail         String?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  messageAt      DateTime
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, groupJid, waMessageId])
  @@index([workspaceId, createdAt])
  @@index([action, nextAttemptAt])
}
